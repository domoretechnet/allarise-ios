	<string>Allarise uses AlarmKit to schedule and manage your wake-up alarms reliably.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- AVFoundation (AVPlayer) media — video_url and audio media_url —
		     may load from insecure origins. -->
		<key>NSAllowsArbitraryLoadsForMedia</key>
		<true/>
		<!-- image_url is fetched by URLSession (SwiftUI AsyncImage), which the
		     media key above does NOT cover. Home Assistant is commonly served
		     over plain http on the LAN (http://homeassistant.local:8123), so
		     without this a picture alert would be blocked by ATS while a video
		     from the same host played fine. Scoped to local/reserved-range
		     hosts — it does not weaken ATS for public internet requests. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
